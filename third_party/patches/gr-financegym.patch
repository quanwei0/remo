@@ -202,7 +202,13 @@ def embed_batch(
   The canonical server is vLLM with Qwen3-Embedding-4B; any backend that
   speaks the same JSON dialect can be substituted by setting ``EMBED_URL``.
   """
-  r = requests.post(url, json={"model": model, "input": texts}, timeout=timeout)
+  payload = {"model": model, "input": texts}
+  # vLLM: server-side truncation for over-length articles (otherwise one long
+  # article 400s the whole batch). Env-gated; unset keeps official behavior.
+  trunc = os.environ.get("EMBED_TRUNCATE_TOKENS")
+  if trunc:
+    payload["truncate_prompt_tokens"] = int(trunc)
+  r = requests.post(url, json=payload, timeout=timeout)
   r.raise_for_status()
   data = sorted(r.json()["data"], key=lambda x: x["index"])
   return [d["embedding"] for d in data]
